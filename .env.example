# ==========================================
# InsureMate - Environment Configuration (.env)
# ==========================================

# 1. API Key
# DashScope: https://dashscope.console.aliyun.com/
# OpenRouter: https://openrouter.ai/keys
# Local Ollama: dummy string, e.g. 'ollama'
QWEN_API_KEY=your_api_key_here

# 2. Base URL (OpenAI-compatible endpoint)
# DashScope (Intl): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OpenRouter:       https://openrouter.ai/api/v1
# Local Ollama:     http://localhost:11434/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 3. Model Name
# e.g., qwen-vl-max, qwen2.5-vl-72b-instruct, qwen/qwen-2.5-vl-72b-instruct
QWEN_MODEL_NAME=qwen-vl-max

# 4. Optional Inference Settings
QWEN_MAX_TOKENS=2048
QWEN_TEMPERATURE=0.1
